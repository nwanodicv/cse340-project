<h1>Welcome to CSE Motors!</h1>
<!-- Hero Section -->
<section id="hero">
    <img src="../images/vehicles/delorean.jpg" alt="CSE Motors">
    <div class="hero-content">
        <h2>DMC Delorean</h2>
        <p class="content-p">3 Cup holders</p>
        <p class="content-p">Superman doors</p>
        <p class="content-p">Fuzzy dice!</p>
        <a href="/inventory" class="btn">Own Today</a>
    </div>
</section>
<section>
    <div id="main-content">
        <!-- Section forDelorean Upgrades -->
        <div class="delorean-container">
            <h2>Delorean Upgrades</h2>
            <div class="upgrades-grid">
                <div class="upgrade-item">
                    <img src="../images/upgrades/flux-cap.png" alt="Flux Capacitor" loading="lazy">
                    <h3 class="flux-capacitor">Flux Capacitor</h3>
               </div>
                <div class="upgrade-item">
                    <img src="../images/upgrades/flame.jpg" alt="Flame" loading="lazy">
                    <h3 class="flame-decals">Flame Decals</h3>
                </div>
                <div class="upgrade-item">
                    <img src="../images/upgrades/bumper_sticker.jpg" alt="Bumper" loading="lazy">
                    <h3 class="bumper-stickers">Bumper Stickers</h3>
                </div>
                <div class="upgrade-item">
                    <img src="../images/upgrades/hub-cap.jpg" alt="Hub" loading="lazy">
                    <h3 class="hub-caps">Hub Caps</h3>
                </div>
            </div>
        </div>
        <!-- Section for Delorean Reviews -->
        <div class="reviews-container">
            <h2>DMC Delorean Reviews</h2>
            <div class="review-item">
                <li>"So fast it's like traveling in time." (4/5)</li>
                <li>"Coolest ride on the road." (4/5)</li>
                <li>"I'm feeling Marty McFly!" (5/5)</li>
                <li>"The most futuristic ride of our day." (4.5/5)</li>
                <li>"80's living and loving it!" (5/5)</li>
            </div>
        </div>
    </div>
</section>
