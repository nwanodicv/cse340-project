<h1>Add New Classification</h1>

<% if (message) { %>
  <p class="notice"><%= message %></p>
<% } %>
<fieldset>
<form class="account-form" action="/inv/add-classification" method="post">
  
  <label for="classificationName">Classification Name:</label>
  <input 
    type="text" 
    name="classification_name" 
    id="classificationName"
    required 
    pattern="^[A-Za-z0-9]+$"
    title="No spaces or special characters allowed"
  >

  <p class="form-hint">
    Classification name cannot contain spaces or special characters.
  </p>

  <button type="submit">Add Classification</button>

</form>
</fieldset>